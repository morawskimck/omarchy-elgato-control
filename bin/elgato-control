#!/usr/bin/env python3
"""Small hidapi-based Stream Deck daemon for Omarchy."""
import argparse, ctypes, hashlib, ipaddress, json, os, pathlib, re, shutil, signal, socket, subprocess, sys, tempfile, time, urllib.error, urllib.request
from xml.sax.saxutils import escape

VID = 0x0FD9
PLUS, PEDAL = 0x0084, 0x0086
MK2, MK2_SCISSOR, MK2_MODULE, ORIGINAL_V2 = 0x0080, 0x00A5, 0x00B9, 0x006D
XL, XL_V2 = 0x006C, 0x008F
NEO = 0x009A
# keys/columns/keySize/flip describe the key grid; flip marks panels whose
# firmware expects key artwork rotated 180 degrees (gen-2 non-Plus hardware).
def key_panel(label, keys, columns, key_size):
    """A key-only panel: no dials, no LCD, and artwork the firmware wants rotated."""
    return {"kind": "streamdeck", "label": label, "slot": "deck",
            "capabilities": ["keys", "brightness"],
            "keys": keys, "columns": columns, "keySize": key_size, "flip": True}

DEVICE_SPECS = {
    PLUS: {"kind": "streamdeck", "label": "Stream Deck +", "slot": "plus",
           "capabilities": ["keys", "dials", "dialPress", "lcd", "touch", "brightness"],
           "keys": 8, "columns": 4, "keySize": 120, "flip": False},
    MK2: key_panel("Stream Deck MK.2", 15, 5, 72),
    MK2_SCISSOR: key_panel("Stream Deck MK.2 Scissor", 15, 5, 72),
    MK2_MODULE: key_panel("Stream Deck MK.2 Module", 15, 5, 72),
    ORIGINAL_V2: key_panel("Stream Deck", 15, 5, 72),
    XL: key_panel("Stream Deck XL", 32, 8, 96),
    XL_V2: key_panel("Stream Deck XL", 32, 8, 96),
    # Eight keys, then two touch sensors reported as keys 8 and 9 that flip
    # pages, and a 248x58 info screen between them. Keys and screen take
    # artwork rotated 180 degrees.
    NEO: {"kind": "streamdeck", "label": "Stream Deck Neo", "slot": "deck",
          "capabilities": ["keys", "brightness", "pages", "screen"],
          "keys": 8, "columns": 4, "keySize": 96, "flip": True, "touchKeys": 2},
    PEDAL: {"kind": "pedal", "label": "Stream Deck Pedal", "slot": "pedal",
            "capabilities": ["pedals"]},
}

def device_spec(product_id):
    return DEVICE_SPECS.get(product_id, {})
ROOT = pathlib.Path(__file__).resolve().parent.parent
CONFIG = pathlib.Path(os.environ.get("XDG_CONFIG_HOME", pathlib.Path.home() / ".config")) / "elgato-control"
STATE = pathlib.Path(os.environ.get("XDG_STATE_HOME", pathlib.Path.home() / ".local/state")) / "elgato-control"
LEGACY_CONFIG = pathlib.Path(os.environ.get("XDG_CONFIG_HOME", pathlib.Path.home() / ".config")) / "omarchy-streamdeck"
PROFILE = CONFIG / "profile.json"
STATUS = STATE / "status.json"
ICONS = ROOT / "assets" / "keys"
KEY_CACHE = pathlib.Path(os.environ.get("XDG_CACHE_HOME", pathlib.Path.home() / ".cache")) / "elgato-control" / "keys"
KEY_ACTIONS = {
    "key_home": "Home", "key_end": "End", "key_page_up": "Page_Up", "key_page_down": "Page_Down",
    "key_left": "Left", "key_right": "Right", "key_up": "Up", "key_down": "Down",
    "key_enter": "Return", "key_escape": "Escape", "key_space": "space", "key_tab": "Tab",
}
BUILTIN_ACTIONS = [
    ("terminal", "Open Terminal"), ("browser", "Open Default Browser"), ("files", "Open Files"),
    ("mic_mute", "Mute Microphone"), ("media_play_pause", "Play / Pause"),
    ("screenshot", "Screenshot"), ("lock", "Lock Screen"), ("omameet", "Open OmaMeet"),
    ("workspace_prev", "Previous Workspace"), ("workspace_next", "Next Workspace"),
    ("overview", "Workspace Overview"), ("volume_down", "Volume Down"), ("volume_up", "Volume Up"),
